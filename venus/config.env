# Native Venus OS defaults. This file contains no secrets.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TLS=false
MQTT_TLS_INSECURE=false
MQTT_RECONNECT_SECONDS=5
OUTPUT_PATH=/data/victron-gx-publisher/output/solar.json
LOG_LEVEL=INFO

# Optional: set the GX VRM portal ID to request retained values after connecting.
# VRM_PORTAL_ID=xxxxxxxxxxxx

NEOCITIES_API_KEY_FILE=/data/victron-gx-publisher/secrets/neocities_api_key
NEOCITIES_REMOTE_PATH=solar.json
NEOCITIES_MIN_UPLOAD_INTERVAL=300
NEOCITIES_SETTLE_SECONDS=10
NEOCITIES_POLL_SECONDS=2
NEOCITIES_REQUEST_TIMEOUT=15
